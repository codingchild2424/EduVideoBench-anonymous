# =============================================================================
# Educational Video Generation Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# fal.ai API Key (required for Sora 2, Veo 3.1, Kling 3.0)
# Get your key at: https://fal.ai/
FAL_AI_API_KEY=your_fal_api_key_here

# OpenRouter API Key (required for VLM evaluation judges: GPT-4o, Gemini 3 Flash)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Enable GPU models (Wan 2.2)
# Set to "true" if you have a compatible NVIDIA GPU
ENABLE_GPU_MODELS=false

# HuggingFace token (optional, for downloading Wan 2.2 weights)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_hf_token_here
